rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'ADMIN';
    }

    function isOps() {
      return isSignedIn() && userRole() == 'OPS_USER';
    }

    function isAdminOrOps() {
      return isAdmin() || isOps();
    }

    // Prevent a non-admin from changing their own role or status.
    function roleAndStatusUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    // ---------- Users ----------
    match /users/{userId} {
      // A user can read their own profile; admins can read all.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // Only admins can create user profiles (except initial bootstrap handled client-side).
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // Admins can update anything. Users can update their own profile but
      // cannot change their role or status.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && roleAndStatusUnchanged());

      // Only admins can delete user profiles.
      allow delete: if isAdmin();
    }

    // ---------- Students ----------
    match /students/{studentId} {
      // Admins and ops can read all students.
      // A USER can only read a student record linked to their own account.
      allow read: if isAdminOrOps()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Only admins and ops can create/update/delete students.
      allow create, update, delete: if isAdminOrOps();
    }

    // ---------- Payments ----------
    match /payments/{paymentId} {
      // Admins and ops read all; a USER reads only their own payments.
      allow read: if isAdminOrOps()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create, update, delete: if isAdminOrOps();
    }

    // ---------- Courses ----------
    match /courses/{courseId} {
      allow read: if true; // public catalogue
      allow create, update, delete: if isAdmin();
    }

    // ---------- Faculty ----------
    match /faculty/{facultyId} {
      allow read: if true; // public
      allow create, update, delete: if isAdmin();
    }

    // ---------- Achievements ----------
    match /achievements/{achievementId} {
      allow read: if true; // public
      allow create, update, delete: if isAdmin();
    }

    // ---------- Gallery ----------
    match /gallery/{imageId} {
      allow read: if true; // public
      allow create, update, delete: if isAdmin();
    }

    // ---------- Website content ----------
    match /websiteContent/{docId} {
      allow read: if true; // public
      allow create, update, delete: if isAdmin();
    }

    // ---------- Contact inquiries ----------
    match /contactInquiries/{inquiryId} {
      allow create: if true; // anyone can submit
      allow read, update, delete: if isAdminOrOps();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
